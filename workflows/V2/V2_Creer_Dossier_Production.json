    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    a.id AS analyse_id,\n    c.id AS contenu_id,\n    c.campagne_id,\n    c.titre,\n    c.auteur,\n    c.description,\n    c.date_publication,\n    c.plateforme,\n    a.resume,\n    a.theme,\n    a.sentiment,\n    a.score_qualite,\n    a.mots_cles,\n    a.langue\nFROM analyses a\nJOIN contenus c ON c.id = a.contenu_id\nWHERE a.id = {{ $('Persistance Analyse').item.json.id }}\nLIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
